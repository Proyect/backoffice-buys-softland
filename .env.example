# Root env file for docker-compose. Duplicate to .env and adjust values.

# ---------- Database ----------
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=backoffice_db
POSTGRES_PORT=5432
# Optional: local testing DB URL (outside Docker) e.g. for Vitest/integration tests
DATABASE_URL_TEST=

# ---------- Backend ----------
BACKEND_PORT=4000
DATABASE_URL=postgres://appuser:apppassword@db:5432/backoffice_db
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=please-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
APP_NAME=backoffice-buys-softland
APP_VERSION=0.1.0
# Optional: base pública para OpenAPI servers (si no se setea, se infiere del request)
PUBLIC_BASE_URL=

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000

# ---------- pgAdmin (optional) ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050
